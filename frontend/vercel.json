{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pact-backend-8p7x.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://pact-backend-8p7x.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://pact-backend-8p7x.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://pact-backend-8p7x.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
