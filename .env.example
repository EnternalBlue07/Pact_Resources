# ==============================================================================
# PACT (Proof, Authorization, Custody & Trust) - Environment Configuration
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN LOCAL DEVELOPMENT VALUES.
# NEVER COMMIT REAL SECRETS, API KEYS, OR PRODUCTION PASSWORDS TO GIT.
# ==============================================================================

# Backend Service Configuration (Provisional: FastAPI)
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication (Provisional: JWT)
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_secure_random_string_for_local_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
HANDOVER_TOKEN_EXPIRE_MINUTES=15

# Database Configuration (Provisional: PostgreSQL / SQLite local fallback)
DATABASE_URL=postgresql://pact_user:pact_password@localhost:5432/pact_db
# Local SQLite fallback for early testing:
# DATABASE_URL=sqlite:///./pact_dev.db

# Frontend Application Configuration (Provisional: React / Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Evidence & File Storage (Provisional: Local storage directory for hackathon)
EVIDENCE_STORAGE_PATH=./storage/evidence
MAX_UPLOAD_SIZE_MB=10

# Audit & Integrity
AUDIT_HASH_SALT=local_salt_placeholder_do_not_use_in_production
